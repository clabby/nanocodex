{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nanocodex-ios-updates",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker.mjs"
}
