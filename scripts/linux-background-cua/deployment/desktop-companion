#!/usr/bin/python3
"""Fixed sudo entry point. Runs as the desktop user, never as root."""
import json, os, pathlib, socket, struct, subprocess, sys
ROOT = pathlib.Path('/opt/nanocodex/background-cua')
if os.geteuid() == 0 or sys.argv[1:] != ['--allow-native-control', 'serve']:
    sys.exit('Expected desktop user and --allow-native-control serve')
uid = os.geteuid()
env = {'PATH': '/usr/bin:/bin', 'HOME': str(pathlib.Path.home()), 'USER': 'gakonst', 'LOGNAME': 'gakonst', 'LANG': 'en_US.UTF-8', 'XDG_RUNTIME_DIR': f'/run/user/{uid}'}
instances = json.loads(subprocess.check_output(['/usr/bin/hyprctl', 'instances', '-j'], env=env, timeout=3))
if len(instances) != 1:
    sys.exit('Exactly one desktop-user Hyprland instance is required; no fallback')
i = instances[0]
signature = i['instance']
if not signature or not all(c.isascii() and (c.isalnum() or c == '_') for c in signature):
    sys.exit('Invalid compositor signature')
for path in [pathlib.Path(env['XDG_RUNTIME_DIR']) / 'hypr' / signature / '.socket.sock', pathlib.Path(env['XDG_RUNTIME_DIR']) / i['wl_socket']]:
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(3); s.connect(str(path))
        pid, peer_uid, _ = struct.unpack('3i', s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if peer_uid != uid or pid != i['pid']:
            sys.exit('Compositor identity mismatch')
env.update(HYPRLAND_INSTANCE_SIGNATURE=signature, WAYLAND_DISPLAY=i['wl_socket'], NANOCODEX_COMPUTER_BACKGROUND='hyprland', NANOCODEX_HYPRLAND_CAPTURE=str(ROOT / 'nanocodex-hyprland-capture'))
# Serialize the first activation; never race two initial CUA conversations.
import fcntl
with open(pathlib.Path(env['XDG_RUNTIME_DIR']) / 'nanocodex-background-cua.lock', 'a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    subprocess.run([str(ROOT / 'activate-plugin.py')], env=env, stdout=subprocess.DEVNULL, check=True, timeout=15)
os.execve(str(ROOT / 'nanocodex-computer'), ['nanocodex-computer', '--allow-native-control', 'serve'], env)
